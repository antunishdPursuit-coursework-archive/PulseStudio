# The studio's server reads these. Copy to .env, fill in, and never commit .env.

# Lets the member support assistant answer. Unset: the assistant reports that
# it is unavailable rather than pretending.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# The staff door. Unset: the dashboard and the re-engagement tool show a
# closed door saying nobody can sign in yet — they never fail open.
# The session cookie is __Host- prefixed, so sign-in works over HTTPS or on
# localhost and refuses anywhere else. That is deliberate.
STAFF_PASSPHRASE=

# Where to listen. Loopback by default: a process holding secrets should not
# answer the whole LAN by accident.
HOST=127.0.0.1
PORT=4173
