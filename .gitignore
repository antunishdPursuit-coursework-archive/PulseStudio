# Dependencies and build output
node_modules/
dist/
build/
.next/

# Compiled TypeScript output — never commit build artifacts (they cause
# merge conflicts that the source never had)
app/**/*.js
app/**/*.js.map

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Local configuration and secrets. Every env file is ignored with no
# exceptions: the un-ignore line that used to sit here named a file this
# repo has never contained, and its name broke the language law.
.env
.env.*

# Operating-system and editor files
.DS_Store
Thumbs.db
.vscode/

# Per-developer AI tool settings. The team's rules are tracked (CLAUDE.md,
# AGENTS.md, .cursor/rules), but which MCP servers you personally enable is
# yours and should never land in a shared commit.
.claude/settings.local.json
